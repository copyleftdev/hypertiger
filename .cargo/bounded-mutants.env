# Deliberately low, and lower than the wrapper's default of a quarter of nproc, which is 16 cores here.
# A sweep of this crate at 8 cores preceded a machine reset on 2026-11-05. One test takes about 10 s,
# so 2 cores is about 1.5 hours for a whole crate: scope a sweep to what changed instead.
MUTANT_CPU_BUDGET=2
